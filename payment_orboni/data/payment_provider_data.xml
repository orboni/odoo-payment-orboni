<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="payment_provider_orboni" model="payment.provider">
        <field name="name">Orboni</field>
        <field name="code">orboni</field>
        <field name="image_128" type="base64" file="payment_orboni/static/description/icon.png"/>
        <field name="module_id" ref="base.module_payment_orboni"/>
        <field name="redirect_form_view_id" ref="redirect_form"/>
        <field name="payment_method_ids" eval="[Command.set([ref('payment_orboni.payment_method_orboni')])]"/>
        <field name="pending_msg" type="html">
            <p>Your crypto payment has arrived and is being confirmed on the network. Your order is confirmed once it is final.</p>
        </field>
    </record>

</odoo>
